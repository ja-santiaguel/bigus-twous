{
  "name": "@big-two/protocol",
  "version": "0.0.0",
  "description": "The wire vocabulary: what a client may say to a table, and what a table says back. Depends only on engine types \u2014 it describes messages, it does not run anything.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@big-two/engine": "*"
  },
  "devDependencies": {
    "@big-two/session": "*",
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "@types/node": "^22.5.0",
    "vitest": "^2.0.5",
    "@big-two/ai": "*"
  }
}
