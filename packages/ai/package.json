{
  "name": "@big-two/ai",
  "version": "0.0.0",
  "description": "CPU player strategies. Depends only on @big-two/engine's public API — never reaches into engine internals.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "tsc -p tsconfig.json",
    "simulate": "tsx src/simulate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "tune": "tsx src/dev/tune.ts"
  },
  "dependencies": {
    "@big-two/engine": "*"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "@types/node": "^22.5.0",
    "vitest": "^2.0.5"
  }
}
