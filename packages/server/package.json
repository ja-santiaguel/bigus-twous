{
  "name": "@big-two/server",
  "version": "0.0.0",
  "description": "Authoritative table server. A transport-agnostic core plus a thin WebSocket adapter.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./table": "./src/table.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@big-two/ai": "*",
    "@big-two/engine": "*",
    "@big-two/protocol": "*",
    "@big-two/session": "*",
    "@types/ws": "^8.18.1",
    "tsx": "^4.16.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
