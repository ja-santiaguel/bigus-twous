{
  "name": "@big-two/session",
  "version": "0.0.0",
  "description": "Authoritative table session. Owns the GameState and runs the turn loop; hands out only redacted per-seat views. The seam between a local game and a server.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@big-two/ai": "*",
    "@big-two/engine": "*"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "@types/node": "^22.5.0",
    "vitest": "^2.0.5"
  }
}
