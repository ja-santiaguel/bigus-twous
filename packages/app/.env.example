# Copy to .env.production (or .env.local) and fill in what you need.
# Everything here is built into the client, so it is visible to anyone who
# opens the page — use credentials whose free quota caps what misuse can cost.

# Who runs shared tables: `browser` (default) or `server`.
# VITE_HOSTING=browser

# The table server's address, for VITE_HOSTING=server when the client is
# hosted somewhere other than the server.
# VITE_TABLE_SERVER=https://tables.example.com

# A TURN relay, for players whose networks block direct connections.
# Use the URLs and credentials your TURN provider gives you.
# VITE_TURN_URLS=turn:relay.example.com:80,turns:relay.example.com:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Or, for a provider that issues short-lived credentials from a URL returning
# an array of ICE servers:
# VITE_TURN_CREDENTIALS_URL=https://example.metered.live/api/v1/turn/credentials?apiKey=...
